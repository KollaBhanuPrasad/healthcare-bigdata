{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Healthcare Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/dashboard/app.py"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Master Pipeline (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Train Random Forest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/machine_learning/train_model.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Hadoop MapReduce",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hadoop/run_mapreduce.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Apache Hive Engine",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hive/run_hive.py",
      "console": "integratedTerminal"
    }
  ]
}
